# nemotron-asr-streaming-farsi-api — example environment
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env (not this file) and set MODEL_DIR to the model folder
#      on YOUR machine.
#   3. Start the server:  docker compose up -d --build
#
# .env is git-ignored and must never be committed — it contains paths
# from your own machine. This .example file is safe to publish because
# it only contains placeholders and defaults.
#
# Only MODEL_DIR is required. Everything else is optional: if you
# delete a line, the default shown next to it is used.

# ---------------------------------------------------------------------
# REQUIRED — where is the model on your machine?
# ---------------------------------------------------------------------
# Absolute path on the HOST to the model folder itself — the folder
# that contains these four files:
#   encoder.int8.onnx   (628 MB)
#   decoder.int8.onnx   (7.0 MB)
#   joiner.int8.onnx    (1.7 MB)
#   tokens.txt          (16 KB)
#
# Download them from:
#   https://huggingface.co/Nimaone/nemotron-asr-streaming-farsi-onnx
#
# Examples (pick the one that matches your machine, then remove the
# leading # if you use it):
#   MODEL_DIR=/home/yourname/models/nemotron-asr-streaming-farsi-onnx
#   MODEL_DIR=./models/nemotron-asr-streaming-farsi-onnx
#
# Do NOT point this at a symlink inside a mounted volume, and do NOT
# point it at the parent folder — it must be the model folder itself.
# Compose mounts it read-only at /models/nemotron-asr-streaming-farsi-onnx
# inside the container, exactly where the server looks for it.
MODEL_DIR=/path/to/nemotron-asr-streaming-farsi-onnx

# ---------------------------------------------------------------------
# SERVER — inside the container (usually leave these alone)
# ---------------------------------------------------------------------
# MODEL_PATH: where the model lives INSIDE the container.
# Change it only if you also change the volume mount in compose.yaml.
# Default: /models/nemotron-asr-streaming-farsi-onnx
MODEL_PATH=/models/nemotron-asr-streaming-farsi-onnx

# ASR_HOST: address the server listens on.
# Keep 127.0.0.1 (localhost only). The server has no authentication,
# so do not set this to 0.0.0.0 unless you know what you are doing.
# Default: 127.0.0.1
ASR_HOST=127.0.0.1

# ASR_PORT: HTTP port. Clients must point at the same port:
# in a client's settings, the server URL is
# http://127.0.0.1:<ASR_PORT>
# Default: 8765
ASR_PORT=8765

# ASR_THREADS: decoding threads for sherpa-onnx. Also sets
# OMP_NUM_THREADS in the container, so the two stay in sync.
# Set it to roughly the number of CPU cores you want to use.
# Default: 8
ASR_THREADS=8

# ASR_SAMPLE_RATE: audio sample rate the server expects, in Hz.
# Clients send 16 kHz mono WAV (for example VocaLinux Remote API).
# Change it only if you also change what the client sends.
# Default: 16000
ASR_SAMPLE_RATE=16000

# ASR_LANGUAGE: language passed to the recognizer.
# This model is Persian-only, so keep fa-IR.
# Default: fa-IR
ASR_LANGUAGE=fa-IR

# ASR_DECODING_METHOD: sherpa-onnx decoding method.
# greedy_search is the fast default. modified_beam_search is slower
# but can be slightly more accurate.
# Default: greedy_search
ASR_DECODING_METHOD=greedy_search

# ASR_MAX_UPLOAD_MB: largest audio upload the server accepts, in MB.
# Requests larger than this are rejected with HTTP 400.
# Default: 50
ASR_MAX_UPLOAD_MB=50

# LOG_LEVEL: how much the server logs.
# One of: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO
